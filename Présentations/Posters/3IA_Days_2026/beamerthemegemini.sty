% Inria / 3IA / DS4H Gemini poster theme; institutional logos in the footer.
\RequirePackage{fontspec}
\RequirePackage{ragged2e}
\usefonttheme{professionalfonts}
\newcommand{\posterfonts}[2]{%
  \setsansfont{EBGaramond12-Regular.#2}[Path={#1},
    BoldFont=EBGaramond12-Regular.#2,BoldFeatures={FakeBold=1.7},
    ItalicFont=EBGaramond12-Italic.#2,
    BoldItalicFont=EBGaramond12-Italic.#2,BoldItalicFeatures={FakeBold=1.7}]
  \setmainfont{EBGaramond12-Regular.#2}[Path={#1},
    BoldFont=EBGaramond12-Regular.#2,BoldFeatures={FakeBold=1.7},
    ItalicFont=EBGaramond12-Italic.#2,
    BoldItalicFont=EBGaramond12-Italic.#2,BoldItalicFeatures={FakeBold=1.7}]}
\IfFileExists{/usr/share/fonts/opentype/ebgaramond/EBGaramond12-Regular.otf}{%
  \posterfonts{/usr/share/fonts/opentype/ebgaramond/}{otf}%
}{\IfFileExists{/usr/share/fonts/truetype/ebgaramond/EBGaramond12-Regular.ttf}{%
  \posterfonts{/usr/share/fonts/truetype/ebgaramond/}{ttf}%
}{\IfFileExists{EBGaramond12-Regular.otf}{\posterfonts{}{otf}}{\posterfonts{}{ttf}}}}
\newlength{\posterblockgap}\setlength{\posterblockgap}{0.8cm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,center]{headline}
    \vskip0.9cm
    {\fontsize{74}{80}\selectfont\bfseries\inserttitle\par}
    \vskip0.2cm
    {\fontsize{37}{43}\selectfont\insertsubtitle\par}
    \vskip0.6cm
    {\fontsize{33}{38}\selectfont\insertauthor\par}
    \vskip0.15cm
    {\fontsize{27}{31}\selectfont\insertinstitute\par}
    \vskip0.8cm
  \end{beamercolorbox}
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.14cm]{headline rule}\end{beamercolorbox}}
% Percolia has its own content block; no duplicate logo or QR in the footer.
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.13cm]{headline rule}\end{beamercolorbox}
  \begin{beamercolorbox}[wd=\paperwidth,center]{headline}
    \vskip0.5cm
    \hbox to \paperwidth{\hskip8cm
      \makebox[16cm][l]{\raisebox{-0.5\height}{\includegraphics[width=9cm]{assets/inria.png}}}\hfil
      \raisebox{-0.5\height}{\includegraphics[width=14cm]{assets/3ia.png}}\hfil
      \makebox[16cm][r]{\raisebox{-0.5\height}{\includegraphics[height=3.1cm]{assets/ds4h.png}}}\hskip8cm}
    \vskip0.4cm
    {\fontsize{24}{28}\selectfont\textbf{AI Cluster 3IA C\^ote d'Azur Days}\quad\textperiodcentered\quad
      Sophia Antipolis, 24--25 September 2026\par}
    \vskip0.45cm
  \end{beamercolorbox}}
% Explicit numbering keeps the two-column reading order stable.
\newenvironment{posterbox}[4][inriagrayblue]{%
  \par\nointerlineskip
  \setbeamercolor{localtitle}{fg=white,bg=#1}%
  \begin{beamercolorbox}[wd=\linewidth,ht=1.35cm,dp=0.45cm,leftskip=0.5cm]{localtitle}
    \fontsize{37}{41}\selectfont\bfseries #2\hspace{0.3cm}#3
  \end{beamercolorbox}\par\nointerlineskip
  \begin{beamercolorbox}[wd=\linewidth,sep=0.5cm]{block body}%
  \begin{minipage}[t][#4][t]{\dimexpr\linewidth-1cm\relax}
    \fontsize{30}{35}\selectfont\RaggedRight
    \setlength{\parskip}{0.25cm}\setlength{\parindent}{0pt}
    \setlength{\abovedisplayskip}{0.25cm}\setlength{\belowdisplayskip}{0.25cm}
}{\end{minipage}\end{beamercolorbox}\par\nointerlineskip}
% Untitled white panels inside the grey Perspective body.
% The argument is the TOTAL panel height, including its 3 mm padding.
\newenvironment{perspectivesubblock}[1]{%
  \par\nointerlineskip
  \setbeamercolor{perspective subbody}{fg=black,bg=white}%
  \begin{beamercolorbox}[wd=\linewidth,sep=0.3cm]{perspective subbody}
  \begin{minipage}[t][\dimexpr#1-0.6cm\relax][t]{\dimexpr\linewidth-0.6cm\relax}
    \fontsize{27}{32}\selectfont\RaggedRight
    \setlength{\parskip}{0.2cm}\setlength{\parindent}{0pt}
}{\end{minipage}\end{beamercolorbox}\par\nointerlineskip}
\newcommand{\perspectivesubgap}{\par\nointerlineskip\vskip0.5cm\nointerlineskip}
\newcommand{\captiontext}[1]{{\fontsize{25}{29}\selectfont\color{inriagrayblue}#1\par}}
\newcommand{\smalltext}[1]{{\fontsize{27}{31}\selectfont #1\par}}
\newcommand{\refb}[1]{\textcolor{inriagrayblue}{\textbf{[#1]}}}
\newcommand{\myref}[1]{\textcolor{inriared}{\textbf{[#1]}}}
